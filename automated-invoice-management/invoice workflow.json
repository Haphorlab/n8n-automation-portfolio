    {
      "parameters": {
        "jsCode": "// Access the trigger node data by referencing the first node\nconst triggerData = $(\"project ready\").first().json;\nconst project = triggerData.fields;\n\n// Access current node input (Airtable client data)\nconst client = $input.first().json;\n\nlet amount = 0;\nlet description = project.Desciption || 'Professional services';\n\n// Calculate amount\nif (project['Project type'] === 'Hourly') {\n  const hours = project['Hours worked'] || 0;\n  const rate = project.Rate || client['Default rate'] || 0;\n  amount = hours * rate;\n  description = `${description}\\n\\n${hours} hours @ $${rate}/hr`;\n  \n} else if (project['Project type'] === 'Fixed Price') {\n  amount = project['Fixed amount'] || 0;\n}\n\n// Generate invoice number\nconst year = new Date().getFullYear();\nconst random = Math.floor(Math.random() * 900000) + 100000;\nconst invoiceNumber = `INV-${year}-${random}`;\n\n// Calculate dates\nconst issueDate = new Date();\nconst dueDate = new Date(issueDate);\nconst paymentTerms = client['Payment terms'] || 'Net 30';\n\nif (paymentTerms === 'Net 15') dueDate.setDate(dueDate.getDate() + 15);\nelse if (paymentTerms === 'Net 30') dueDate.setDate(dueDate.getDate() + 30);\nelse if (paymentTerms === 'Net 45') dueDate.setDate(dueDate.getDate() + 45);\n\nconst formatDate = (d) => d.toISOString().split('T')[0];\n\nreturn {\n  invoiceNumber,\n  clientName: client['Client name'],\n  clientEmail: client.Email,\n  clientAddress: client.Address || '',\n  clientCompany: client.Company || '',\n  amount,\n  description,\n  issueDate: formatDate(issueDate),\n  dueDate: formatDate(dueDate),\n  paymentTerms,\n  projectId: triggerData.id,\n  projectName: project['Project name'],\n  clientId: client.id\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
