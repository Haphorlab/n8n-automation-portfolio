    {
      "parameters": {
        "documentType": "html",
        "htmlCode": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 20px; }\n    .header { display: flex; justify-content: space-between; margin-bottom: 40px; }\n    .invoice-title { font-size: 32px; font-weight: bold; color: #333; }\n    .invoice-number { color: #666; }\n    .section { margin: 30px 0; }\n    .label { font-weight: bold; color: #333; }\n    table { width: 100%; border-collapse: collapse; margin: 20px 0; }\n    th { background: #f5f5f5; padding: 12px; text-align: left; border-bottom: 2px solid #ddd; }\n    td { padding: 12px; border-bottom: 1px solid #eee; }\n    .total { font-size: 20px; font-weight: bold; text-align: right; margin-top: 20px; }\n    .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #eee; color: #666; font-size: 14px; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <div>\n      <div class=\"invoice-title\">INVOICE</div>\n      <div class=\"invoice-number\">{{ $json.invoiceNumber }}</div>\n    </div>\n    <div style=\"text-align: right;\">\n      <div class=\"label\">Issue Date</div>\n      <div>{{ $json.issueDate }}</div>\n      <div class=\"label\" style=\"margin-top: 10px;\">Due Date</div>\n      <div>{{ $json.dueDate }}</div>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"label\">Bill To:</div>\n    <div>{{ $json.clientName }}</div>\n    <div>{{ $json.clientCompany }}</div>\n    <div>{{ $json.clientEmail }}</div>\n  </div>\n\n  <table>\n    <thead>\n      <tr>\n        <th>Description</th>\n        <th>Project</th>\n        <th style=\"text-align: right;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>{{ $json.description }}</td>\n        <td>{{ $json.projectName }}</td>\n        <td style=\"text-align: right;\">${{ $json.amount }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"total\">\n    Total Due: ${{ $json.amount }}\n  </div>\n\n  <div class=\"footer\">\n    <div>Payment Terms: {{ $json.paymentTerms }}</div>\n    <div style=\"margin-top: 10px;\">Thank you for your business!</div>\n  </div>\n</body>\n</html>",
        "options": {}
